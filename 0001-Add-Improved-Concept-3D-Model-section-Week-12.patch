+    <div class="hint">Drag to rotate · scroll or pinch to zoom</div>
+    <div class="err" id="err">This browser could not start the 3D view (WebGL is off). Open the page in Chrome, Safari or Edge.</div>
+    <div class="bar"><i id="prog"></i></div>
+    <div class="caption" aria-live="polite">
+      <span class="step" id="stepn">Demo</span>
+      <p id="cap">SpinShelf is a freestanding motorized carousel. Press a section button and that section turns to the front.</p>
+    </div>
+  </section>
+
+  <div class="controls">
+    <section class="card">
+      <h2>Push-button panel</h2>
+      <p>One colour-coded button per section, the same as on the model. Press one and that section turns to the front.</p>
+      <div class="row" role="group" aria-label="Sections">
+        <button class="shelf" id="b0" style="--c:var(--s1)" aria-pressed="true">Spices</button>
+        <button class="shelf" id="b1" style="--c:var(--s2)" aria-pressed="false">Cans</button>
+        <button class="shelf" id="b2" style="--c:var(--s3)" aria-pressed="false">Mugs</button>
+        <button class="shelf" id="b3" style="--c:var(--s4)" aria-pressed="false">Bowls</button>
+      </div>
+      <div class="row">
+        <button class="stopb" id="stop">STOP</button>
+        <button id="block" aria-pressed="false">Block the shelf</button>
+      </div>
+      <div class="status" id="status">Spices section is at the front.</div>
+    </section>
+
+    <section class="card">
+      <h2>View</h2>
+      <div class="row">
+        <button class="primary" id="play">Replay demo</button>
+        <button id="shell" aria-pressed="true">See-through shell</button>
+      </div>
+      <ul class="legend">
+        <li><i style="--c:#d98a3d"></i>Motor and drive shaft in the base</li>
+        <li><i style="--c:#b58a5a"></i>Shelf carousel, turns as one piece</li>
+        <li><i style="--c:#33474a"></i>Push-button panel at armrest height</li>
