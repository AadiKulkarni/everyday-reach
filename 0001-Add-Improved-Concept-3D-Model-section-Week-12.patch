+<body>
+<div class="wrap">
+  <header>
+    <h1>SpinShelf</h1>
+    <p>Helping wheelchair users reach everyday kitchen items on their own. Team 15 concept model.</p>
+  </header>
+
+  <section class="stage" aria-label="3D model of SpinShelf">
