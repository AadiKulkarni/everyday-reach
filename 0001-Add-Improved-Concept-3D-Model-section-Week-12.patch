+    <!-- Week 12: Improved concept, 3D model -->
+    <section id="model3d" class="section section--alt">
+      <div class="container">
+        <header class="section-header">
+          <h2>Improved Concept &amp; 3D Model</h2>
+          <p>An interactive model of the improved SpinShelf concept for wheelchair users, with updated concept views and storyboard.</p>
+        </header>
+
+        <div class="subsection">
+          <h3>Interactive 3D model</h3>
+          <p>
+            Drag to rotate and scroll or pinch to zoom. The walkthrough plays on load: Margaret presses the Mugs button on the panel by her armrest and the carousel turns that section to the front. The buttons under the model work the same way as the panel. Dimensions in the model are working assumptions, not tested values.
+          </p>
+          <div class="model-frame">
+            <iframe
+              src="assets/wk12/spinshelf-3d.html"
+              title="Interactive 3D concept model of SpinShelf"
+              loading="lazy"
+            ></iframe>
+          </div>
+          <p class="download-row">
+            <a class="btn-download" href="assets/wk12/spinshelf-3d.html" target="_blank" rel="noopener noreferrer">Open the 3D model in a new tab</a>
+          </p>
+        </div>
+
+        <div class="subsection">
+          <h3>Improved concept views and storyboard</h3>
+          <div class="sketch-grid sketch-grid--wide">
+            <figure class="figure sketch-card">
+              <a class="sketch-link" href="assets/wk12/spinshelf-concept-views.png" target="_blank" rel="noopener noreferrer">
+                <img
+                  src="assets/wk12/spinshelf-concept-views.png"
+                  alt="Four views of the improved SpinShelf concept: front, side, see-through and top, with a wheelchair user at the cabinet"
+                  loading="lazy"
+                />
+              </a>
+              <figcaption>Improved concept: seated reach height, open knee space, one colour-coded button per section on a panel at armrest height.</figcaption>
+            </figure>
+            <figure class="figure sketch-card">
+              <a class="sketch-link" href="assets/wk12/spinshelf-storyboard-v2.png" target="_blank" rel="noopener noreferrer">
+                <img
+                  src="assets/wk12/spinshelf-storyboard-v2.png"
+                  alt="Eight-frame storyboard of Margaret, a wheelchair user, pressing the Mugs button on SpinShelf and taking her mug from the front opening"
+                  loading="lazy"
+                />
+              </a>
+              <figcaption>Updated interaction storyboard: Margaret gets her mug without leaning out of her chair or waiting for help.</figcaption>
+            </figure>
+          </div>
+        </div>
+      </div>
+    </section>
