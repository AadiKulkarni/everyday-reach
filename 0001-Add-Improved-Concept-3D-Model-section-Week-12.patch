+/* ---------- build frame ---------- */
+function drawItem(b,m,it,col){
+  if(it.k==='mug'){cyl(b,m,.04,.09,col,{segs:16,cap:[col[0]*.6,col[1]*.6,col[2]*.6,1]});box(b,X(m,T(.052,.045,0)),.022,.05,.012,col);}
