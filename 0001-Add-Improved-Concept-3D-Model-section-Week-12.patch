+/* ---------- interaction ---------- */
+const $=id=>document.getElementById(id);
+const NAMES=['Spices','Cans','Mugs','Bowls'];
+function setStatus(s){$('status').textContent=s;}
+function mark(i){S.sel=i;[0,1,2,3].forEach(n=>$('b'+n).setAttribute('aria-pressed',String(n===i)));}
